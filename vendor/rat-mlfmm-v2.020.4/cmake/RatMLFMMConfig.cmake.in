get_filename_component(RatMLFMM_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
include(CMakeFindDependencyMacro)

# add path
list(APPEND CMAKE_MODULE_PATH ${RatMLFMM_CMAKE_DIR})
if(@ENABLE_CUDA@)
	include("${RatMLFMM_CMAKE_DIR}/EnableLanguageCUDA.cmake")
	include("${RatMLFMM_CMAKE_DIR}/ConvertCUDAFlags.cmake")
endif()
list(REMOVE_AT CMAKE_MODULE_PATH -1)

find_dependency(RatCommon)
if(CMAKE_CUDA_COMPILER AND @ENABLE_CUDA@)
	CUDA_CONVERT_FLAGS(Rat::Common)
endif()

if(NOT TARGET Rat::MLFMM)
    include("${RatMLFMM_CMAKE_DIR}/RatMLFMMTargets.cmake")
endif()

set(RatMLFMM_LIBRARIES Rat::MLFMM)

